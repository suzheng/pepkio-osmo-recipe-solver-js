{
  "name": "pepkio-osmo-recipe-solver",
  "version": "0.1.0",
  "description": "Multi-solute osmolarity calculator with real osmotic coefficients, preset buffers, tonicity classification, and bidirectional recipe adjustment via the Pepkio Tools REST API.",
  "readme": "README_NPM.md",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-osmo-recipe-solver": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-osmo-recipe-solver-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-osmo-recipe-solver-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/osmo-recipe-solver",
  "keywords": [
    "osmo-recipe-solver",
    "osmolarity",
    "osmolality",
    "tonicity",
    "buffer-preparation",
    "cell-culture",
    "electrophysiology",
    "ionic-strength",
    "laboratory-calculator",
    "molecular-biology",
    "bioinformatics",
    "pepkio",
    "typescript",
    "node",
    "rest-api"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "tsup": "^9.0.0",
    "typescript": "^5.8.2",
    "vitest": "^5.1.1"
  }
}
